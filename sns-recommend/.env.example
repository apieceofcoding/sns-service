# SNS app database (accounts, posts) and recommendation database (vectors, jobs)
SOURCE_DATABASE_URL=postgresql://snsuser:snspassword@localhost:5432/snsdb
DATABASE_URL=postgresql://recommend:recommend@localhost:55432/recommend
REDIS_URL=redis://localhost:56379/0
CURSOR_SECRET=course-local-cursor-secret
MODEL_MODE=live
